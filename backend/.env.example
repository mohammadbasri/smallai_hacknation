# Copy to .env and adjust. All values have safe defaults in app/config.py.
APP_NAME=karibu-backend
DEBUG=true
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Below this confidence the tool says "not sure, ask a person" (human-in-the-loop). Same value is read by the browser runtime.
CONFIDENCE_THRESHOLD=0.65
# Operator (Noor) language. Visitors are answered in en / fr / sw.
DEFAULT_LANGUAGE=sw
# Shared models + templates (default: <repo>/shared). Keep them small: they are side-loaded to phones.
# SHARED_DIR=../shared
# SQLite file (default: backend/data/karibu.db)
# DB_PATH=./data/karibu.db
# Built frontend to serve from the API origin (default: ../frontend/dist)
# STATIC_DIR=../frontend/dist

# SMS channel. console = log to outbox only (demo). africastalking | twilio send for real.
SMS_PROVIDER=console
SMS_OPERATOR_NUMBER=+000000000000
SMS_SERVICE_NUMBER=+000000000001
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
