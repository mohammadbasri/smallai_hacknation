# Copy to .env and adjust. All values have safe defaults in app/config.py.
APP_NAME=smallai-backend
DEBUG=true
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Below this confidence the API returns "not sure, ask a person" (human-in-the-loop)
CONFIDENCE_THRESHOLD=0.65
# Local language the tool is demonstrated in (ISO 639-1). Name it; judges will ask.
DEFAULT_LANGUAGE=sw
# Where small model files live (keep them side-loadable: a few MB, quantized)
MODEL_DIR=./models
